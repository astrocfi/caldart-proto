# Daily trigger for the CalDART scheduled reports.
#
# Deploy root: /opt/caldart, with the checkout in caldart/.
# deploy/steps/timers.sh installs and enables it.
# Inspect with:
#   systemctl list-timers caldart-reports.timer

[Unit]
Description=Send the CalDART scheduled reports daily at 06:00
Documentation=file:///opt/caldart/caldart/docs/developer/deployment.rst

[Timer]
Unit=caldart-reports.service

# 06:00 every day, in Pacific time, so the reports are waiting in the
# inbox at the start of the day, ahead of the 06:30 renewals and the 07:00
# reminders.
# The zone is the site's TIME_ZONE, so the timer fires on the site's clock
# whatever time zone the server is set to.
OnCalendar=*-*-* 06:00:00 America/Los_Angeles

# If the machine was off or suspended at 06:00, run as soon as it comes back:
# whatever was due is still due, and the run sends it.
Persistent=true

# Reports are date-driven, not time-critical to the second; letting systemd
# coalesce the wakeup is cheaper.
AccuracySec=1min

# Spread the start over five minutes so the run does not land at the same
# instant as every other 06:00 job on the host.
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
