# Daily trigger for the CalDART automatic-renewal scan.
#
# Deploy root: /opt/caldart, with the checkout in caldart/.
# deploy/steps/timers.sh installs and enables it.
# Inspect with:
#   systemctl list-timers caldart-renewals.timer

[Unit]
Description=Run the CalDART automatic-renewal scan daily at 06:30
Documentation=file:///opt/caldart/caldart/docs/developer/deployment.rst

[Timer]
Unit=caldart-renewals.service

# 06:30 every day, in Pacific time -- half an hour before the reminder
# scan, so a membership this run renews is never also sent a reminder about
# running out.
# The zone is the site's TIME_ZONE, so the timer fires on the site's clock
# whatever time zone the server is set to.
OnCalendar=*-*-* 06:30:00 America/Los_Angeles

# If the machine was off or suspended at 06:30, run as soon as it comes back
# rather than skipping that day's renewals entirely.
Persistent=true

# Renewals are date-driven, not time-critical to the second; letting systemd
# coalesce the wakeup is cheaper.
AccuracySec=1min

# Spread the start over five minutes so the scan does not land at the same
# instant as every other job on the host.
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
