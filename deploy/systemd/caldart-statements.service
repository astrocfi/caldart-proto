# CalDART year-end contribution statements.
#
# Deploy path: /srv/caldart. Triggered by caldart-statements.timer, which runs
# it once a year on January 15th; it is a oneshot, so it is not enabled
# directly -- enable the timer instead:
#
#   sudo cp deploy/systemd/caldart-statements.service \
#           deploy/systemd/caldart-statements.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now caldart-statements.timer
#
# Run it by hand (safe to repeat -- a year already sent reaches nobody again):
#   sudo systemctl start caldart-statements.service
#   journalctl -u caldart-statements -n 50

[Unit]
Description=CalDART year-end contribution statements
Documentation=file:///srv/caldart/docs/developer/deployment.rst
# Needs the database and outbound SMTP.
After=network.target docker.service caldart-web.service
Wants=network-online.target

[Service]
Type=oneshot

User=caldart
Group=caldart
UMask=0027

WorkingDirectory=/srv/caldart/backend

# Same configuration as the web service: DATABASE_URL, EMAIL_URL and
# DEFAULT_FROM_EMAIL are the ones this command actually uses.
EnvironmentFile=/etc/caldart/caldart.env

Environment=DJANGO_SETTINGS_MODULE=caldart.settings.prod
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# Sends the previous calendar year's contribution statements to every active
# account that gave. Add --dry-run to rehearse, or --year=YYYY to name another
# year, or --today=YYYY-MM-DD to run as of another date.
ExecStart=/srv/caldart/.venv/bin/python /srv/caldart/backend/manage.py send_year_statements

# A slow SMTP server, or a year with many givers, should not leave this
# hanging until the next trigger.
TimeoutStartSec=900

# --- Hardening --------------------------------------------------------------
# Same profile as caldart-web, minus the writable media/staticfiles paths --
# this command only reads the database, builds statement PDFs in memory, and
# sends mail.

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
# Present so "systemctl enable caldart-statements.service" is not an error,
# but the timer is what should normally be enabled.
WantedBy=multi-user.target
