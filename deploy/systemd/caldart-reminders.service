# CalDART renewal reminder scan.
#
# Deploy path: /srv/caldart. Triggered by caldart-reminders.timer, which runs
# it daily at 07:00; it is a oneshot, so it is not enabled directly -- enable
# the timer instead:
#
#   sudo cp deploy/systemd/caldart-reminders.service \
#           deploy/systemd/caldart-reminders.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now caldart-reminders.timer
#
# Run it by hand (safe to repeat -- ReminderLog dedupes per user/membership/kind):
#   sudo systemctl start caldart-reminders.service
#   journalctl -u caldart-reminders -n 50

[Unit]
Description=CalDART renewal reminder scan
Documentation=file:///srv/caldart/docs/developer/deployment.rst
# Needs the database and outbound SMTP.
After=network.target docker.service caldart-web.service
Wants=network-online.target

[Service]
Type=oneshot

User=caldart
Group=caldart
UMask=0027

WorkingDirectory=/srv/caldart/backend

# Same configuration as the web service: DATABASE_URL, EMAIL_URL,
# DEFAULT_FROM_EMAIL and SITE_URL are the ones this command actually uses
# (the reminder emails link to SITE_URL + /portal/renew).
EnvironmentFile=/etc/caldart/caldart.env

Environment=DJANGO_SETTINGS_MODULE=caldart.settings.prod
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# Sends the t60 / t30 / t7 / expired / post30 emails and flips memberships
# whose ends_on has passed to "expired". Add --dry-run to rehearse, or
# --today=YYYY-MM-DD to scan as of another date.
ExecStart=/srv/caldart/.venv/bin/python /srv/caldart/backend/manage.py send_renewal_reminders

# A slow SMTP server should not leave this hanging until the next trigger.
TimeoutStartSec=900

# --- Hardening --------------------------------------------------------------
# Same profile as caldart-web, minus the writable media/staticfiles paths --
# this command only reads the database and sends mail.

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
# Present so "systemctl enable caldart-reminders.service" is not an error, but
# the timer is what should normally be enabled.
WantedBy=multi-user.target
