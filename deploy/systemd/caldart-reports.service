# CalDART scheduled reports: the report subscriptions and the DART rosters.
#
# Deploy root: /opt/caldart, with the checkout in caldart/.
# Triggered by caldart-reports.timer, which runs it
# daily at 06:00; it is a oneshot, so it is not enabled directly.
# deploy/steps/timers.sh installs it and enables the timer.
#
# Run it by hand (safe to repeat -- a sent subscription moves on to its next
# day, and a sent roster is stamped with the month):
#   sudo systemctl start caldart-reports.service
#   journalctl -u caldart-reports -n 50

[Unit]
Description=CalDART scheduled reports
Documentation=file:///opt/caldart/caldart/docs/developer/deployment.rst
# Needs the database and outbound SMTP.
After=network.target docker.service caldart-web.service
Wants=network-online.target

[Service]
Type=oneshot

User=caldart
Group=caldart
UMask=0027

WorkingDirectory=/opt/caldart/caldart/backend

# Same configuration as the web service: DATABASE_URL, EMAIL_URL and
# DEFAULT_FROM_EMAIL are the ones this command actually uses.
EnvironmentFile=/etc/caldart/caldart.env

Environment=DJANGO_SETTINGS_MODULE=caldart.settings.prod
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# Sends every report subscription that is due and every DART roster not yet
# sent this month. Add --dry-run to rehearse, or --today=YYYY-MM-DD to run as
# of another date.
ExecStart=/opt/caldart/caldart/.venv/bin/python /opt/caldart/caldart/backend/manage.py send_scheduled_reports

# A slow SMTP server should not leave this hanging until the next trigger.
TimeoutStartSec=900

# --- Hardening --------------------------------------------------------------
# Same profile as caldart-web, minus the writable media/staticfiles paths --
# this command only reads the database, writes the email log, and sends mail.

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
# Present so "systemctl enable caldart-reports.service" is not an error, but
# the timer is what should normally be enabled.
WantedBy=multi-user.target
