# CalDART FAA registry import.
#
# Deploy root: /opt/caldart, with the checkout in caldart/.
# Triggered by caldart-registry.timer, which runs it
# daily at 04:30; it is a oneshot, so it is not enabled directly.
# deploy/steps/timers.sh installs it and enables the timer.
#
# Run it by hand (safe to repeat -- every run replaces the registry with the
# FAA's current copy):
#   sudo systemctl start caldart-registry.service
#   journalctl -u caldart-registry -n 50

[Unit]
Description=CalDART FAA registry import
Documentation=file:///opt/caldart/caldart/docs/developer/deployment.rst
# Needs the database and an outbound HTTPS connection to registry.faa.gov.
After=network-online.target docker.service caldart-web.service
Wants=network-online.target

[Service]
Type=oneshot

User=caldart
Group=caldart
UMask=0027

WorkingDirectory=/opt/caldart/caldart/backend

# Same configuration as the web service: DATABASE_URL and FAA_REGISTRY_URL are
# the ones this command actually uses.
EnvironmentFile=/etc/caldart/caldart.env

Environment=DJANGO_SETTINGS_MODULE=caldart.settings.prod
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# Downloads the Releasable Aircraft Database from FAA_REGISTRY_URL into a
# temporary file and imports its aircraft types and registrations. Add
# --types-only to refresh the aircraft types alone, or --source to read a zip
# or a directory already on disk.
ExecStart=/opt/caldart/caldart/.venv/bin/python /opt/caldart/caldart/backend/manage.py import_faa_registry

# The download is about 70 MB and the import writes some 300,000 rows; a slow
# link should still not leave this hanging until the next trigger.
TimeoutStartSec=1800

# --- Hardening --------------------------------------------------------------
# Same profile as caldart-web, minus the writable media/staticfiles paths --
# this command writes only the database and its own private /tmp.

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
# Present so "systemctl enable caldart-registry.service" is not an error, but
# the timer is what should normally be enabled.
WantedBy=multi-user.target
