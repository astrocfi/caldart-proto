# Hourly trigger for the CalDART bounce check.
#
# Deploy root: /opt/caldart, with the checkout in caldart/.
# deploy/steps/timers.sh installs and enables it.
# Inspect with:
#   systemctl list-timers caldart-bounces.timer

[Unit]
Description=Check the CalDART bounce mailbox every hour
Documentation=file:///opt/caldart/caldart/docs/developer/deployment.rst

[Timer]
Unit=caldart-bounces.service

# At 20 minutes past every hour, in Pacific time -- a minute when no daily
# job starts.
# The zone is the site's TIME_ZONE, so the timer fires on the site's clock
# whatever time zone the server is set to.
OnCalendar=*-*-* *:20:00 America/Los_Angeles

# If the machine was off or suspended at the trigger, run as soon as it comes
# back rather than waiting for the next hour.
Persistent=true

# A bounce marked a few minutes later doesn't change anything; letting systemd
# coalesce the wakeup is cheaper.
AccuracySec=1min

# Spread the start over five minutes so the run does not land at the same
# instant as every other job on the host.
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
