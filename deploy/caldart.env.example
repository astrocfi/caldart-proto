# CalDART production environment -- the template for /etc/caldart/caldart.env.
#
# Start from this file, never from the repository's `.env.example`: that one
# carries development defaults, including a published SECRET_KEY and the mock
# payment provider, which hands out memberships for free.
#
#   sudo install -m 0640 -o root -g caldart \
#        deploy/caldart.env.example /etc/caldart/caldart.env
#   sudoedit /etc/caldart/caldart.env
#
# docs/developer/configuration.rst documents every variable, what reads it, and
# its production value. Values are read once, at start-up: after editing this
# file, run `systemctl restart caldart-web`.
#
# The five variables in the first block are commented out on purpose. An
# unedited copy refuses to start rather than serving with a guessed value.

# -- required: uncomment every one and set it ----------------------------
# Django's signing key. 50+ random characters, unique to this deployment:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#SECRET_KEY=

# Every hostname the vhost answers for, including the www. form.
#ALLOWED_HOSTS=caldart.example.org,www.caldart.example.org

# The public base URL, no trailing slash. Used in email links and by Wagtail.
#SITE_URL=https://caldart.example.org

# SMTP connection URL. Credentials are URL-encoded, so an @ becomes %40.
#EMAIL_URL=smtp+tls://user:password@smtp.example.org:587

# Postgres connection URL, with the password set in step 4 of the deployment
# guide -- not the development one.
#DATABASE_URL=postgres://caldart:CHANGE-THIS-PASSWORD@localhost:5432/caldart

# -- core ----------------------------------------------------------------
DEBUG=false
# Origins allowed to post to the site, with scheme. Required behind TLS
# termination; it defaults to SITE_URL alone.
CSRF_TRUSTED_ORIGINS=https://caldart.example.org,https://www.caldart.example.org

# -- email ---------------------------------------------------------------
# Must be a domain the SMTP relay may send as, or SPF and DMARC will bounce it.
DEFAULT_FROM_EMAIL=CalDART <noreply@caldart.example.org>
# Seconds to wait on the SMTP server. Keeps a wedged relay off a request.
#EMAIL_TIMEOUT=20
# Comma-separated addresses that receive unhandled-500 mail. Empty is fine:
# the traceback is in the journal either way.
#ADMIN_EMAILS=

# -- auth rate limits ----------------------------------------------------
# DRF throttle rates for the anonymous auth endpoints, as "<count>/<period>".
# An empty value turns that throttle off.
AUTH_THROTTLE_LOGIN=20/min
AUTH_THROTTLE_REGISTER=10/hour
AUTH_THROTTLE_PASSWORD_RESET=10/hour

# -- Stripe --------------------------------------------------------------
# The live key pair. Leave blank to hide Stripe from the checkout provider list.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# whsec_..., used to verify the signature on POST /payments/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
# Absolute path to the file Stripe issues for Apple Pay domain verification.
STRIPE_APPLE_PAY_DOMAIN_ASSOCIATION=

# -- PayPal --------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=live
# Optional. Set it and POST /payments/paypal/webhook verifies each
# notification's signature with PayPal before filing it.
PAYPAL_WEBHOOK_ID=

# -- frontend ------------------------------------------------------------
# false makes Django read frontend/dist/.vite/manifest.json from `npm run build`.
DJANGO_VITE_DEV_MODE=false
# Override the manifest location. The default suits the /srv/caldart layout.
#DJANGO_VITE_MANIFEST_PATH=

# -- user guide ----------------------------------------------------------
# Where the deployment guide's sphinx-build step wrote the user guide the site
# serves at /docs/. Defaults to docs/_build/guide under the checkout.
#USER_GUIDE_ROOT=/srv/caldart/docs/_build/guide

# -- backups -------------------------------------------------------------
# Must be listed in ReadWritePaths in deploy/systemd/caldart-web.service.
BACKUP_DIR=/srv/caldart/backups
# false prefers the local pg_dump/psql; install postgresql-client for it.
DB_BACKUP_VIA_DOCKER=false

# -- hardening -----------------------------------------------------------
# Every one of these has a safe default; uncomment only to change it.
# Redirect plain HTTP to HTTPS.
#SECURE_SSL_REDIRECT=true
# Strict-Transport-Security max-age. Set it to 0 for the first deploy of a new
# hostname: browsers honor the header for its whole duration.
#SECURE_HSTS_SECONDS=31536000
# Turn this off if other services run on subdomains without TLS.
#SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Consent to the browser preload list. Very hard to undo; leave it off unless
# every current and future subdomain will serve HTTPS forever.
#SECURE_HSTS_PRELOAD=false
# Root logger level. Everything goes to the journal.
#LOG_LEVEL=INFO
# Seconds to keep a database connection open between requests.
#DB_CONN_MAX_AGE=60
# Read by deploy/gunicorn.conf.py, not by Django: how many worker processes to
# run. Defaults to 2 x cores + 1, capped at 12.
#WEB_CONCURRENCY=

# -- Content-Security-Policy ---------------------------------------------
# No variable here. Django sends an enforced Content-Security-Policy built
# from CONTENT_SECURITY_POLICY in backend/caldart/settings/base.py, which
# already names the Stripe and PayPal origins the checkout needs. Widening it
# -- another payment provider, an analytics script, an embedded video --
# means editing that dictionary, not this file. Do not set the header in the
# vhost either: the application leaves a header the response already carries
# alone, so a vhost copy would replace the policy wholesale. Check what a box
# is sending with:
#   curl -sI https://caldart.example.org/ | grep -i content-security-policy
