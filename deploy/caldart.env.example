# CalDART production environment -- the template for /etc/caldart/caldart.env.
#
# Start from this file, never from the repository's `.env.example`: that one
# carries development defaults, including a published SECRET_KEY and the mock
# payment provider, which hands out memberships for free.
#
# deploy/steps/configure.sh writes /etc/caldart/caldart.env from this template
# once, filling in the required variables below; run again once the file
# exists, it leaves it alone but for CALDART_GUNICORN_PORT, which it keeps at
# the port install.sh --gunicorn-port recorded. To change a value by hand:
#
#   sudoedit /etc/caldart/caldart.env
#   sudo systemctl restart caldart-web
#
# docs/developer/configuration.rst documents every variable, what reads it, and
# its production value. Values are read once, at start-up, hence the restart.
#
# The five variables in the first block are commented out on purpose. An
# unedited copy refuses to start rather than serving with a guessed value.

# -- required: uncomment every one and set it ----------------------------
# Django's signing key. 50+ random characters, unique to this deployment:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#SECRET_KEY=

# Every hostname the vhost answers for, including the www. form.
#ALLOWED_HOSTS=caldart.example.org,www.caldart.example.org

# The public base URL, no trailing slash. Used in email links and by Wagtail.
#SITE_URL=https://caldart.example.org

# SMTP connection URL: a relay, with credentials URL-encoded so an @ becomes
# %40, or smtp://localhost:25 for the postfix on this machine (install.sh
# --email local), which needs no credentials.
#EMAIL_URL=smtp+tls://user:password@smtp.example.org:587

# Postgres connection URL, with the password set in step 4 of the deployment
# guide -- not the development one -- and the port install.sh --db-port chose.
#DATABASE_URL=postgres://caldart:CHANGE-THIS-PASSWORD@localhost:5432/caldart

# -- core ----------------------------------------------------------------
DEBUG=false
# The path under a shared host, e.g. /caldart-proto; SITE_URL must end in it.
#URL_PREFIX=
# Origins allowed to post to the site, with scheme. Required behind TLS
# termination; it defaults to SITE_URL alone.
CSRF_TRUSTED_ORIGINS=https://caldart.example.org,https://www.caldart.example.org
# The port on 127.0.0.1 where the web server's proxy reaches gunicorn; not the
# site's port, which is 80 and 443 on the web server. gunicorn.conf.py reads it,
# and Django ignores it. install.sh --gunicorn-port writes it and rewrites the
# vhost to match, so change it with that flag rather than here.
CALDART_GUNICORN_PORT=8001

# -- email ---------------------------------------------------------------
# Must be a domain the SMTP relay (or this machine's postfix) may send as, or
# SPF and DMARC will bounce it.
DEFAULT_FROM_EMAIL=CalDART <noreply@caldart.example.org>
# Seconds to wait on the SMTP server. Keeps a wedged relay off a request.
#EMAIL_TIMEOUT=20
# Comma-separated addresses that receive unhandled-500 mail. Empty is fine:
# the traceback is in the journal either way.
#ADMIN_EMAILS=
# The envelope sender (Return-Path) of every message: where a receiving server
# returns mail it cannot deliver. The From header stays DEFAULT_FROM_EMAIL.
# Blank sends the envelope from DEFAULT_FROM_EMAIL as well.
#BOUNCE_ADDRESS=bounces@caldart.example.org
# The mailbox caldart-bounces.service reads the returned reports from, as
# imaps://user:password@host[:port]/MAILBOX with the credentials URL-encoded
# (an @ becomes %40). Blank turns bounce checking off.
BOUNCE_IMAP_URL=
# The DKIM selector the mail server or relay signs messages with. `manage.py
# check_mail_dns` and the portal's Mail delivery screen look for its public key at
# <selector>._domainkey.<domain of DEFAULT_FROM_EMAIL>. Blank skips that check with a
# warning.
#DKIM_SELECTOR=mail

# -- bulk email ------------------------------------------------------------
# caldart-bulk-email.service sends at most this many copies a minute; keep it
# under the mail provider's own limit. Copies per mail connection follow.
#BULK_EMAIL_RATE_PER_MINUTE=30
#BULK_EMAIL_BATCH_SIZE=50
# Seconds between pressing Send and the first copy, while it can be cancelled.
#BULK_EMAIL_UNDO_SECONDS=120
# Above this many recipients, Send asks for the count to be typed to confirm.
#BULK_EMAIL_CONFIRM_ABOVE=50

# -- auth rate limits ----------------------------------------------------
# DRF throttle rates for the anonymous auth endpoints, as "<count>/<period>".
# An empty value turns that throttle off.
AUTH_THROTTLE_LOGIN=20/min
AUTH_THROTTLE_REGISTER=10/hour
AUTH_THROTTLE_PASSWORD_RESET=10/hour
# Following an email verification link, and asking for a fresh one (each resend
# sends a message, so it stays low).
AUTH_THROTTLE_VERIFY=30/hour
AUTH_THROTTLE_VERIFY_RESEND=5/hour
# Starting a gift on the public donation page, which may make a donor account.
AUTH_THROTTLE_DONATE=10/hour

# -- address suggestions ------------------------------------------------
# The Geoapify key behind the profile form's address suggestions. Blank turns
# the suggestions off.
GEOAPIFY_API_KEY=
# Suggestions one signed-in account may ask for, as "<count>/<period>".
ADDRESS_SUGGEST_THROTTLE_RATE=60/min
# The autocomplete endpoint. Only the end-to-end run points it elsewhere.
#GEOAPIFY_URL=https://api.geoapify.com/v1/geocode/autocomplete

# -- FAA registry --------------------------------------------------------
# Where caldart-registry.service downloads the FAA's Releasable Aircraft
# Database from; a local zip or directory works too.
#FAA_REGISTRY_URL=https://registry.faa.gov/database/ReleasableAircraft.zip
# Minutes an import started with Run now may stay unfinished before the next
# press records it as failed and starts another.
#REGISTRY_IMPORT_STALE_MINUTES=30

# -- email verification --------------------------------------------------
# Seconds a verification link stays usable. The default is three days.
#EMAIL_VERIFICATION_TIMEOUT=259200

# -- Stripe --------------------------------------------------------------
# The live key pair. Leave blank to hide Stripe from the checkout provider list.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# whsec_..., used to verify the signature on POST /payments/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
# Absolute path to the file Stripe issues for Apple Pay domain verification.
STRIPE_APPLE_PAY_DOMAIN_ASSOCIATION=

# -- PayPal --------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=live
# Optional. Set it and POST /payments/paypal/webhook verifies each
# notification's signature with PayPal before filing it.
PAYPAL_WEBHOOK_ID=

# -- payments ------------------------------------------------------------
# The development switch for the mock provider. Production ignores it, so a copied
# development environment can never turn the mock on; leave it unset.
#PAYMENTS_MOCK_ENABLED=
# The mock provider renders Succeed / Fail buttons, so anyone who can sign in can
# grant themselves a membership. Turn it on only to demonstrate the checkout
# without payment keys, and off again before real members sign in.
#PAYMENTS_MOCK_ENABLED_IN_PRODUCTION=false

# -- frontend ------------------------------------------------------------
# false makes Django read frontend/dist/.vite/manifest.json from `npm run build`.
DJANGO_VITE_DEV_MODE=false
# Override the manifest location. The default suits the /opt/caldart layout.
#DJANGO_VITE_MANIFEST_PATH=

# -- user guide ----------------------------------------------------------
# Where the deployment guide's sphinx-build step wrote the user guide the site
# serves at /docs/. Defaults to docs/_build/guide under the checkout.
#USER_GUIDE_ROOT=/opt/caldart/caldart/docs/_build/guide

# -- uploads -------------------------------------------------------------
# Wagtail's image and document uploads, in the deploy root beside the checkout.
# Must be listed in ReadWritePaths in deploy/systemd/caldart-web.service, and
# is the directory the web server serves /media/ from.
MEDIA_ROOT=/opt/caldart/media

# -- backups -------------------------------------------------------------
# The database dumps, in the deploy root beside the checkout.  Must be listed
# in ReadWritePaths in deploy/systemd/caldart-web.service.
BACKUP_DIR=/opt/caldart/backups
# false prefers the local pg_dump/psql; install postgresql-client for it.
DB_BACKUP_VIA_DOCKER=false
# Read by deploy/systemd/caldart-backup.service, not by Django: dumps older
# than this many days are deleted after each nightly backup.
BACKUP_RETENTION_DAYS=30

# -- hardening -----------------------------------------------------------
# Every one of these has a safe default; uncomment only to change it.
# Redirect plain HTTP to HTTPS.
#SECURE_SSL_REDIRECT=true
# Strict-Transport-Security max-age. Set it to 0 for the first deploy of a new
# hostname: browsers honor the header for its whole duration.
#SECURE_HSTS_SECONDS=31536000
# Turn this off if other services run on subdomains without TLS.
#SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Consent to the browser preload list. Very hard to undo; leave it off unless
# every current and future subdomain will serve HTTPS forever.
#SECURE_HSTS_PRELOAD=false
# Root logger level. Everything goes to the journal.
#LOG_LEVEL=INFO
# Seconds to keep a database connection open between requests.
#DB_CONN_MAX_AGE=60
# Read by deploy/gunicorn.conf.py, not by Django: how many worker processes to
# run. Defaults to 2 x cores + 1, capped at 12.
#WEB_CONCURRENCY=

# -- Content-Security-Policy ---------------------------------------------
# No variable here. Django sends an enforced Content-Security-Policy built
# from CONTENT_SECURITY_POLICY in backend/caldart/settings/base.py, which
# already names the Stripe and PayPal origins the checkout needs. Widening it
# -- another payment provider, an analytics script, an embedded video --
# means editing that dictionary, not this file. Do not set the header in the
# vhost either: the application leaves a header the response already carries
# alone, so a vhost copy would replace the policy wholesale. Check what a box
# is sending with:
#   curl -sI https://caldart.example.org/ | grep -i content-security-policy
