# CalDART environment. docs/developer/configuration.rst documents every variable.
#
# `make setup` copies this to `.env` if you do not have one. Every variable
# below is read in `backend/caldart/settings/base.py` and has a working
# development default, so an unedited copy runs the whole stack locally.

# -- core ---------------------------------------------------------------
# Per-worker database, so parallel branches never collide:
#   postgres://caldart:caldart@localhost:5432/caldart_<branch-slug>
DATABASE_URL=postgres://caldart:caldart@localhost:5432/caldart
SECRET_KEY=dev-insecure-secret-key-change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
SITE_URL=http://localhost:8000
# The path the site is served under when it shares its host, such as
# /caldart-proto; SITE_URL must then end in it. Empty serves from the root.
#URL_PREFIX=

# -- auth rate limits ---------------------------------------------------
# DRF throttle rates for the auth endpoints, as "<count>/<period>",
# where the period is second, minute, hour or day. Leave one empty to turn
# that throttle off; a value Django cannot parse stops start-up.
AUTH_THROTTLE_LOGIN=20/min
AUTH_THROTTLE_REGISTER=10/hour
AUTH_THROTTLE_PASSWORD_RESET=10/hour
AUTH_THROTTLE_VERIFY=30/hour
AUTH_THROTTLE_VERIFY_RESEND=5/hour
# Gifts started on the public donation page, per client address.
AUTH_THROTTLE_DONATE=10/hour

# How long an email verification link stays usable, in seconds (three days).
EMAIL_VERIFICATION_TIMEOUT=259200

# -- address suggestions ------------------------------------------------
# The Geoapify key behind the profile form's address suggestions. Leave it
# blank to turn the suggestions off; the Address box is then a plain text box.
GEOAPIFY_API_KEY=
# Suggestions one signed-in account may ask for, as "<count>/<period>".
# Leave empty to turn the limit off.
ADDRESS_SUGGEST_THROTTLE_RATE=60/min

# -- FAA registry ---------------------------------------------------------
# Where the nightly registry import reads the FAA's Releasable Aircraft Database:
# the zip's URL, or a local zip or directory holding ACFTREF.txt and MASTER.txt.
FAA_REGISTRY_URL=https://registry.faa.gov/database/ReleasableAircraft.zip
# Minutes an import started from the System screen may run before a second
# Run now treats it as failed and starts another.
REGISTRY_IMPORT_STALE_MINUTES=30

# -- email (Mailpit in dev: SMTP 1025, web UI http://localhost:8025) ----
EMAIL_URL=smtp://localhost:1025
DEFAULT_FROM_EMAIL=CalDART <noreply@caldart.example.org>
# The envelope sender bounces return to; blank is DEFAULT_FROM_EMAIL.
BOUNCE_ADDRESS=
# The bounce mailbox, imaps://user:password@host[:port]/MAILBOX; blank turns
# `make bounces` into a run that says bounce checking is off.
BOUNCE_IMAP_URL=
# The DKIM selector the mail server signs with, so `manage.py check_mail_dns` can
# look for its public key; blank skips that check with a warning.
DKIM_SELECTOR=

# -- bulk email -----------------------------------------------------------
# Copies the background sender sends a minute, and per mail connection.
#BULK_EMAIL_RATE_PER_MINUTE=30
#BULK_EMAIL_BATCH_SIZE=50
# Seconds between pressing Send and the first copy, while it can be canceled.
#BULK_EMAIL_UNDO_SECONDS=120
# Above this many recipients, Send asks for the count to be typed to confirm.
#BULK_EMAIL_CONFIRM_ABOVE=50
# Where replies to a bulk email go unless its sender chooses another; blank is the
# sender's own address.
#BULK_EMAIL_REPLY_TO=
# How often one account may run a bulk email's checks; empty is off.
#BULK_EMAIL_CHECKS_THROTTLE_RATE=30/min
# How often one mission callout answer link may send an answer; empty is off.
#CALLOUT_ANSWER_THROTTLE_RATE=10/hour

# How long a bulk email's unsubscribe link keeps working, in seconds (180 days).
UNSUBSCRIBE_TOKEN_MAX_AGE=15552000

# -- Stripe -------------------------------------------------------------
# Leave blank to hide Stripe from the checkout provider list.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Absolute path to the file Stripe issues for Apple Pay domain verification.
STRIPE_APPLE_PAY_DOMAIN_ASSOCIATION=

# -- PayPal -------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional. Set it and the PayPal webhook verifies its signature; leave it
# blank and the webhook only records payloads (capture is authoritative).
PAYPAL_WEBHOOK_ID=

# -- payments ------------------------------------------------------------
# The mock provider renders Succeed / Fail buttons. On in dev and tests,
# off in production.
PAYMENTS_MOCK_ENABLED=true

# -- frontend ------------------------------------------------------------
# true  -> Django loads assets from the Vite dev server on :5173 (`make dev-frontend`)
# false -> Django reads frontend/dist/.vite/manifest.json (`make build`)
DJANGO_VITE_DEV_MODE=false

# -- uploads -------------------------------------------------------------
# Unset, Wagtail's uploads and bulk email images go to backend/media in the
# checkout.  A server sets an absolute path beside the checkout instead
# (docs/developer/configuration.rst).
#MEDIA_ROOT=
# The largest image a bulk email's sender may upload, in bytes, and the widest
# one is stored, in pixels; a wider image is scaled down.
#BULK_EMAIL_IMAGE_MAX_BYTES=5242880
#BULK_EMAIL_IMAGE_MAX_WIDTH=1200

# -- backups -------------------------------------------------------------
# Relative to the repository root.  A server sets an absolute path beside the
# checkout instead.
BACKUP_DIR=backups
# true when pg_dump is only available inside the docker compose `db` service.
DB_BACKUP_VIA_DOCKER=true

# -- trusted origins ------------------------------------------------------
# Origins allowed to post to the site, with scheme. Defaults to SITE_URL's origin.
#CSRF_TRUSTED_ORIGINS=

# -- production-only settings ---------------------------------------------
# Read only by caldart.settings.prod; deploy/caldart.env.example is the template
# a server starts from. Each is commented out with its default.
# Comma-separated addresses that receive unhandled-500 mail.
#ADMIN_EMAILS=
# Seconds to wait on the SMTP server.
#EMAIL_TIMEOUT=20
# Seconds to keep a database connection open between requests.
#DB_CONN_MAX_AGE=60
# Root logger level.
#LOG_LEVEL=INFO
# Turns the mock payment provider on in production; never set it on a live site.
#PAYMENTS_MOCK_ENABLED_IN_PRODUCTION=false
# Redirect plain HTTP to HTTPS.
#SECURE_SSL_REDIRECT=true
# Strict-Transport-Security max-age in seconds.
#SECURE_HSTS_SECONDS=31536000
# Send includeSubDomains with the Strict-Transport-Security header.
#SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Consent to the browser HSTS preload list; very hard to undo.
#SECURE_HSTS_PRELOAD=false
